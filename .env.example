# ── Обязательное ────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ── Файлы и каталоги ────────────────────────────────────────────────────────
# Куда качать временные файлы (удаляются после отправки)
DOWNLOAD_DIR=downloads
# Настройки пользователей и логи
DATA_DIR=data
# cookies/*.txt в формате Netscape (см. README)
COOKIES_DIR=cookies

# Лимит отправки, МБ. 50 — облачный Telegram Bot API.
# Если поднят локальный Bot API server, можно 2000. Значения выше предела API
# автоматически ограничиваются: 50 без локального API и 2000 с ним.
MAX_UPLOAD_MB=50

# ── Поведение ───────────────────────────────────────────────────────────────
# Сколько загрузок одновременно (2–3 разумно)
MAX_CONCURRENT_DOWNLOADS=2
# Пауза между задачами одного пользователя, секунды
RATE_LIMIT_SECONDS=10
# Качество по умолчанию
# 0 = лучшее доступное, либо 2160 / 1440 / 1080 / 720 / 480 / 360
DEFAULT_VIDEO_HEIGHT=0
DEFAULT_AUDIO_KBPS=192

# ── Сеть ────────────────────────────────────────────────────────────────────
# Прокси для yt-dlp и Threads, например http://user:pass@127.0.0.1:1080
# PROXY_URL=
# Локальный Bot API server (поднимает лимит до 2 ГБ), например http://127.0.0.1:8081
# TELEGRAM_LOCAL_API_URL=
# Для Docker-запуска с файлами до 2 ГБ (docker-compose.large.yml):
# получите на https://my.telegram.org/apps, затем MAX_UPLOAD_MB=2000
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# ── Доступ ──────────────────────────────────────────────────────────────────
# Пусто = бот открыт всем. Иначе список Telegram ID через запятую.
# ALLOWED_USER_IDS=111111111,222222222
# Кто может смотреть /stats
# ADMIN_IDS=111111111

# ── Прочее ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# auto | node | deno | bun | none
YTDLP_JS_RUNTIME=auto
# Полный путь к ffmpeg.exe или папке bin (если не в PATH)
# FFMPEG_PATH=C:\ffmpeg\bin
# Оставить скачанные файлы на диске (для отладки)
KEEP_FILES=false
# Удалять накопившиеся сообщения при старте.
# Для GitHub Actions поставьте false, чтобы не терять сообщения между окнами.
DROP_PENDING_UPDATES=true
